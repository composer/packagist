{% extends 'user/security_layout.html.twig' %}

{% block title %}Authenticator app - {{ parent() }}{% endblock %}

{% block security_content %}
    <p>
        Use an app that supports time-based one-time passwords (TOTP), such as
        <a href="https://2fas.com/">2FAS</a>,
        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2">Google Authenticator</a>,
        or
        <a href="https://keepassxc.org/">KeePassXC</a>.
    </p>

    <p><small>(This is not an exhaustive list of compatible apps. Packagist does not endorse or recommend one application over another.)</small></p>

    <h3>Set up an authenticator app</h3>

    <div class="authenticator-setup">
        <div class="authenticator-instructions">
            <p>To set up an authenticator app for your Packagist account:</p>
            <ol>
                <li>Open your authenticator app.</li>
                <li>Add an account within the app and scan the QR code shown here.</li>
                <li>Enter the code generated by your authenticator app below.</li>
            </ol>
        </div>

        <figure class="two-factor-key">
            <img src="{{ qrCode }}" width="200" height="200" alt="Scan this QR code with your authenticator app" />
            <figcaption class="mt-2"><small>TOTP Key: <code style="user-select: all">{{ tfaConfig.secret }}</code></small></figcaption>
        </figure>

        {{ form_start(form, {'attr': { 'class': 'account-form authenticator-code-form' } }) }}
            {{ form_errors(form) }}

            <div class="form-group clearfix">
                {{ form_label(form.code, 'Authenticator code') }}
                <div class="input-group">
                    <span class="input-group-text"><span class="icon-key"></span></span>
                    {{ form_widget(form.code, {attr: {inputmode: 'numeric', autocomplete: 'one-time-code', pattern: '[0-9]{6}', maxlength: 6}}) }}
                </div>
                {{ form_errors(form.code) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Enable authenticator app</button>
                <a href="{{ path('security_authenticator') }}" class="btn btn-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
