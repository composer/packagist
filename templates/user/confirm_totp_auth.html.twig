{% extends 'user/security_layout.html.twig' %}

{% block title %}Authenticator app - {{ parent() }}{% endblock %}

{% block security_content %}
    <h3>Save your backup code</h3>

    <div class="account-form p-4 bg-body-secondary border rounded">
        <p>A backup code lets you sign in if you lose access to your authenticator app. Save this one-time code somewhere safe:</p>

        <kbd class="two-factor-backup-code">{{ backup_code }}</kbd>

        <p class="text-danger"><strong>Without access to your authenticator app or backup code, you will permanently lose access to your account.</strong></p>

        <p>To use the backup code, enter it when you are asked for a code from your authenticator app.</p>

        <p>
            Please take a moment to put this code in a safe place.
            <strong>This code will not be shown again!</strong>
        </p>
    </div>

    <div class="account-form form-actions">
        <a href="{{ path('security_overview') }}" class="btn btn-primary">
            <span class="icon-check"></span>
            I have saved the backup code
        </a>
    </div>
{% endblock %}
