{% extends 'user/security_layout.html.twig' %}

{% block title %}Change password - {{ parent() }}{% endblock %}

{% block security_content %}
    {{ form_start(form, { 'action': path('change_password'), 'attr': { 'class': 'change_password account-form', 'id': 'change_password' } }) }}
        {{ form_errors(form) }}

        <div class="form-group clearfix">
            {{ form_label(form.current_password) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-key"></span></span>
                {{ form_widget(form.current_password) }}
            </div>
            {{ form_errors(form.current_password) }}
        </div>

        <div class="form-group clearfix">
            {{ form_label(form.plainPassword) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-lock"></span></span>
                {{ form_widget(form.plainPassword) }}
            </div>
            {{ form_errors(form.plainPassword) }}
        </div>

        {{ form_widget(form) }}

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="_change_password_submit">Change password</button>
            <a href="{{ path('security_overview') }}" class="btn btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
