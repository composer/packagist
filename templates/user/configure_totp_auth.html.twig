{% extends 'user/security_layout.html.twig' %}

{% block title %}Security - {{ parent() }}{% endblock %}

{% block security_content %}
    {% if backup_code %}
        <div class="alert alert-info">
            <p>If you lose access to your second factors, you can use this one-time backup code to sign in: <code>{{ backup_code }}</code></p>
            <p><strong>Take a moment to record this in a safe place. This code will not be shown again!</strong></p>
        </div>
    {% endif %}

    {% if isActualUser %}
        <p class="text-body-secondary mb-4">Manage your password and second factors.</p>

        <section class="card mb-3" aria-labelledby="password-heading">
            <div class="card-body">
                <h4 class="h5" id="password-heading">Password</h4>
                <p>Keep your account secure with a strong, unique password.</p>
                <a class="btn btn-secondary" href="{{ path('change_password') }}">Change password</a>
            </div>
        </section>
    {% endif %}
    <section class="card mb-3" aria-labelledby="authenticator-heading">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                <h4 class="h5 mb-0" id="authenticator-heading">Authenticator app</h4>
                <span class="badge {{ user.totpAuthenticationEnabled ? 'text-bg-success' : 'text-bg-secondary' }}">{{ user.totpAuthenticationEnabled ? 'Enabled' : 'Not set up' }}</span>
            </div>
            <p>Use a time-based code from your authenticator app as your second factor when signing in.</p>
            {% if isActualUser %}
                <a class="btn {{ user.totpAuthenticationEnabled ? 'btn-secondary' : 'btn-primary' }}" href="{{ path('security_authenticator') }}">{{ user.totpAuthenticationEnabled ? 'View authenticator app settings' : 'Set up an authenticator app' }}</a>
            {% elseif user.totpAuthenticationEnabled %}
                <a class="btn btn-danger" href="{{ path('user_totp_disable', {name: user.username}) }}">Remove authenticator app</a>
            {% endif %}
        </div>
    </section>
    {% if not isActualUser or is_granted(constant('App\\Security\\Voter\\WebAuthnVoter::VIEW')) %}
        <section class="card mb-3" aria-labelledby="passkeys-heading">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                    <h4 class="h5 mb-0" id="passkeys-heading">Passkeys and security keys</h4>
                    <span class="badge {{ user.webAuthnCredentials is not empty ? 'text-bg-success' : 'text-bg-secondary' }}">{{ user.webAuthnCredentials is not empty ? 'Enabled' : 'Not set up' }}</span>
                </div>
                <p>Use a passkey or security key as your second factor when signing in.</p>
                {% if isActualUser %}
                    <a class="btn {{ user.webAuthnCredentials is not empty ? 'btn-secondary' : 'btn-primary' }}" href="{{ path('user_webauthn_manage') }}">{{ user.webAuthnCredentials is not empty ? 'View passkeys and security keys' : 'Set up a passkey or security key' }}</a>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endblock %}
