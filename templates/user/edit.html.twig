{% extends "user/layout.html.twig" %}

{% block user_content %}
    {{ form_start(form, { 'action': path('edit_profile'), 'attr': { 'class': 'edit_profile col-lg-6', 'id': 'edit_profile' } }) }}
        {{ form_errors(form) }}

        <div class="form-group clearfix">
            {{ form_label(form.username) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-user"></span></span>
                {{ form_widget(form.username) }}
            </div>
            {{ form_errors(form.username) }}
        </div>

        <div class="form-group clearfix">
            {{ form_label(form.email) }}
            <div class="input-group clearfix">
                <span class="input-group-text"><span class="icon-mail"></span></span>
                {{ form_widget(form.email) }}
            </div>
            {{ form_errors(form.email) }}
        </div>

        {% if not app.user.githubId %}
        <div class="form-group clearfix">
            {{ form_label(form.current_password) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-lock"></span></span>
                {{ form_widget(form.current_password) }}
            </div>
            {{ form_errors(form.current_password) }}
        </div>
        {% endif %}

        <div class="failure-notifications form-check">
            {{ form_widget(form.failureNotifications, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.failureNotifications, 'Notify me of package update failures', {'label_attr': {'class': 'form-check-label'}}) }}
            {{ form_errors(form.failureNotifications) }}
        </div>

        {{ form_rest(form) }}

        <input type="submit" class="btn w-100 btn-success btn-lg" value="Update" id="_edit_profile_submit" />

        <hr>

        <h5>Using GitHub:</h5>
        <a href="{{ app.user.githubId ? '#' : path('connect_github_start') }}" class="btn w-100 btn-github btn-lg {{ app.user.githubId ? 'disabled' : 'btn-primary' }}">
            <span class="icon-github"></span>
            {% set ghUser = app.user.githubUsername %}
            {% if app.user.githubId %}
                Account connected to {{ ghUser|default('unknown') }}
            {% else %}
                Connect accounts
            {% endif %}
        </a>

        {% if app.user.githubId %}
            {% if ghUser == false %}
                <p>Unknown GitHub user, token is missing, log out and log in again via GitHub to fix it, or <a href="{{ path('user_github_disconnect', {token: csrf_token('unlink_github')}) }}">disconnect your GitHub account</a> entirely to connect another one.</p>
            {% else %}
                <p><a href="{{ path('user_github_disconnect', {token: csrf_token('unlink_github')}) }}">Disconnect your GitHub account</a> to connect another one.</p>
            {% endif %}
        {% endif %}
    {{ form_end(form) }}

    <div class="col-lg-2">
    </div>
{% endblock user_content %}
