{% extends "user/layout.html.twig" %}

{% block title %}Settings - {{ parent() }}{% endblock %}

{% block user_content %}
<section class="col-lg-9">
    {{ form_start(form, { 'action': path('edit_profile'), 'attr': { 'class': 'edit_profile account-form', 'id': 'edit_profile' } }) }}
        {{ form_errors(form) }}

        <div class="form-group clearfix">
            {{ form_label(form.username) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-user"></span></span>
                {{ form_widget(form.username) }}
            </div>
            {{ form_errors(form.username) }}
        </div>

        <div class="form-group clearfix">
            {{ form_label(form.email) }}
            <div class="input-group clearfix">
                <span class="input-group-text"><span class="icon-mail"></span></span>
                {{ form_widget(form.email) }}
            </div>
            {{ form_errors(form.email) }}
        </div>

        {% if not app.user.githubId %}
        <div class="form-group clearfix">
            {{ form_label(form.current_password) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-lock"></span></span>
                {{ form_widget(form.current_password) }}
            </div>
            {{ form_errors(form.current_password) }}
        </div>
        {% endif %}

        <div class="failure-notifications">
            {{ form_widget(form.failureNotifications) }}
            {{ form_errors(form.failureNotifications) }}
        </div>

        {{ form_rest(form) }}

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="_edit_profile_submit">Update</button>
            <a href="{{ path('my_profile') }}" class="btn btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}

    <section class="account-form mt-4" aria-labelledby="github-heading">
        <h3 class="h5" id="github-heading">GitHub account</h3>
        <p>{{ app.user.githubId ? 'Use your connected GitHub account to sign in.' : 'Connect your account to sign in with GitHub.' }}</p>
        <a href="{{ app.user.githubId ? '#' : path('connect_github_start') }}" class="btn btn-github {{ app.user.githubId ? 'disabled' : '' }}"{% if app.user.githubId %} aria-disabled="true" tabindex="-1"{% endif %}>
            <span class="icon-github"></span>
            {% set ghUser = app.user.githubUsername %}
            {% if app.user.githubId %}
                Account connected to {{ ghUser|default('unknown') }}
            {% else %}
                Connect accounts
            {% endif %}
        </a>

        {% if app.user.githubId %}
            {% if ghUser == false %}
                <p>Unknown GitHub user, token is missing, log out and log in again via GitHub to fix it, or <a href="{{ path('user_github_disconnect', {token: csrf_token('unlink_github')}) }}">disconnect your GitHub account</a> entirely to connect another one.</p>
            {% else %}
                <p><a href="{{ path('user_github_disconnect', {token: csrf_token('unlink_github')}) }}">Disconnect your GitHub account</a> to connect another one.</p>
            {% endif %}
        {% endif %}
    </section>
</section>
{% endblock user_content %}
