{% extends 'user/security_layout.html.twig' %}

{% block title %}Confirm authenticator app - {{ parent() }}{% endblock %}

{% block security_content %}
    <h3>Confirm your identity</h3>
    <p>Enter a code from your authenticator app to confirm this change to your security settings.</p>

    {% if user.webAuthnCredentials is not empty %}
        <p><a href="{{ path('user_webauthn_manage', {return_to: return_to}) }}">Confirm with a passkey or security key instead</a></p>
    {% endif %}

    {{ form_start(form, {'attr': {'class': 'account-form'}}) }}
        {{ form_errors(form) }}

        <div class="form-group">
            {{ form_label(form.code) }}
            <div class="input-group">
                <span class="input-group-text"><span class="icon-key" aria-hidden="true"></span></span>
                {{ form_widget(form.code) }}
            </div>
            {{ form_errors(form.code) }}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Confirm identity</button>
            <a href="{{ path('security_authenticator') }}" class="btn btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
