{% extends 'user/security_layout.html.twig' %}

{% block title %}Confirm authenticator app - {{ parent() }}{% endblock %}

{% block security_content %}
    <h3>Confirm your identity</h3>
    <p>Enter a code from your authenticator app before removing it from your account.</p>

    <form method="post" action="{{ path('user_verify_totp') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('verify_totp') }}">
        <div class="mb-3">
            <label for="totp-code" class="form-label">Authenticator code</label>
            <input type="text" id="totp-code" name="code" class="form-control{{ invalid_code ? ' is-invalid' : '' }}" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus{% if invalid_code %} aria-invalid="true" aria-describedby="totp-error"{% endif %}>
            {% if invalid_code %}
                <div id="totp-error" class="invalid-feedback">The authenticator code is invalid. Please try again.</div>
            {% endif %}
        </div>
        <button type="submit" class="btn btn-primary">Confirm identity</button>
        <a href="{{ path('security_authenticator') }}" class="btn btn-secondary">Cancel</a>
    </form>
{% endblock %}
