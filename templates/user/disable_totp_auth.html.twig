{% extends 'user/security_layout.html.twig' %}

{% block title %}Authenticator app - {{ parent() }}{% endblock %}

{% block security_content %}
    <h3>Remove authenticator app?</h3>

    <p>Removing the authenticator app means you will no longer be asked for codes from this app when signing in. Its backup code will also be invalidated.</p>

    <form class="account-form" method="post" action="{{ path('user_totp_disable', {name: user.username}) }}">
        <input type="hidden" name="token" value="{{ csrf_token('disable_totp') }}">
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Remove authenticator app</button>
            <a class="btn btn-secondary" href="{{ isActualUser ? path('security_authenticator') : path('user_totp_configure', {name: user.username}) }}">Keep authenticator app</a>
        </div>
    </form>
{% endblock %}
