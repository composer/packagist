{% extends 'user/security_layout.html.twig' %}

{% block security_content %}
    <h3 class="text-danger">Remove authenticator app?</h3>

    <p>Removing the authenticator app means you will no longer be asked for codes from this app when signing in. Its backup code will also be invalidated.</p>

    <p>If you'd like to proceed anyway, simply click the button below.</p>

    <div class="row">
        <div class="col-lg-6">
            <a class="btn btn-lg btn-inverse" href="{{ path('user_2fa_configure', {name: user.username}) }}">Keep authenticator app</a>
        </div>
        <div class="col-lg-6">
            <a href="{{ path('user_2fa_disable', {token: csrf_token('disable_2fa'), name: user.username}) }}" class="btn w-100 btn-danger btn-lg">
                <span class="icon-lock-open"></span>
                Remove authenticator app
            </a>
        </div>
    </div>
{% endblock %}
