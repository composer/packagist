<section class="row">
    <section class="col-lg-12">
        {% if entries|length %}
            <ul class="packages list-unstyled">
                {% for entry in entries %}
                    <li class="row">
                        <div class="col-12 package-item">
                            <div class="row">
                                <div class="col-md-7 col-xl-8">
                                    <p>
                                        Flagged version: {{ entry.version }}

                                        Reason: {{ entry.reason }}

                                        {% if entry.link %}
                                            <a href="{{ entry.link }}">View details on {{ entry.source.displayName }}</a>
                                        {% endif %}
                                    </p>

                                </div>
                                <div class="col-md-5 col-xl-4">
                                    <p>
                                        {% if is_granted('ROLE_FILTER_LIST_ADMIN') %}
                                            <a class="float-end" href="{{ path('admin_filter_list_edit', {publicId: entry.publicId}) }}" title="Edit entry"><span class="bi bi-pencil-fill"></span></a>
                                        {% endif %}
                                        {% if entry.source.url and entry.source.logo %}
                                            Reported by: <a href="{{ entry.source.url }}"><img alt="{{ entry.source.displayName }}" class="filter-list-log" src="{{ asset(entry.source.logo) }}" /></a>
                                        {% else %}
                                            Reported by: {{ entry.source.displayName }}
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="alert alert-danger">
                <p>{{ 'listing.no_filter_list_entries'|trans }}</p>
            </div>
        {% endif %}
    </section>
</section>
