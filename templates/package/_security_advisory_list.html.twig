<section class="row">
    <section class="col-md-12">
        {% if securityAdvisories|length %}
            <ul class="packages list-unstyled">
                {% for advisory in securityAdvisories %}
                    <li class="row">
                        <div class="col-xs-12 package-item">
                            <div class="row">
                                <div class="col-sm-8 col-lg-9">
                                    <h4 class="font-bold">
                                        {% if advisory.severity %}<span class="label label-severity {{ advisory.severity.labelClass }}">{{ advisory.severity.value|capitalize }}</span>{% endif %}
                                        <a href="{{ advisory.link }}">{{ advisory.title }}</a>
                                        {% if advisory.withdrawnAt %}<span class="label label-default">Withdrawn {{ advisory.withdrawnAt|date('Y-m-d') }}</span>{% endif %}
                                    </h4>
                                    <p>
                                        <a href="{{ path('view_advisory', {id: advisory.packagistAdvisoryId}) }}">{{ advisory.packagistAdvisoryId }}</a>
                                        {% if advisory.cve %}
                                            <a href="http://cve.mitre.org/cgi-bin/cvename.cgi?name={{ advisory.cve }}">{{ advisory.cve }}</a>
                                        {% endif %}
                                        {% for source in advisory.sources %}
                                            {% if source.source == 'GitHub' and source.remoteId is not empty %}
                                                <a href="https://github.com/advisories/{{ source.remoteId }}">{{ source.remoteId }}</a>
                                            {% endif %}
                                        {% endfor %}
                                    </p>
                                    {% if withPackage|default(false) %}<p>Affected package: {% if advisory.packageName is existing_package %}<a href="{{ path('view_package', { 'name': advisory.packageName }) }}">{{ advisory.packageName }}</a>{% else %}{{ advisory.packageName }}{% endif %}</p>{% endif %}
                                    <p>Affected version: {{ advisory.affectedVersions }}</p>
                                </div>
                                <div class="col-sm-4 col-lg-3">
                                    <p>Reported by:{% for source in advisory.sources %}<br/>{{ source.source }}{% if source.publishedAt %} <span class="text-muted">published {{ source.publishedAt|date('Y-m-d') }}</span>{% endif %}{% if source.withdrawnAt %} <span class="text-muted">withdrawn {{ source.withdrawnAt|date('Y-m-d') }}</span>{% endif %}{% endfor %}</p>
                                </div>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% elseif emptyMessage|default(null) %}
            <p class="text-muted">{{ emptyMessage }}</p>
        {% else %}
            <div class="alert alert-danger">
                <p>{{ 'listing.no_security_advisories'|trans }}</p>
            </div>
        {% endif %}
    </section>
</section>
