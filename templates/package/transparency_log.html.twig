{% extends "layout.html.twig" %}

{% set showSearchDesc = 'hide' %}

{% block title %}Transparency Log - {{ name }} - {{ parent() }}{% endblock %}

{% block head_additions %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-xs-12 package">
            <div class="package-header">
                <h2 class="title">
                    <a href="{{ path("view_package", {name: name}) }}">{{ name }}</a>
                    Transparency Log
                </h2>
            </div>
        </div>
    </div>

    <p>Public, append-only record of ownership, package and version changes for this package.</p>

    {% include 'transparency_log/_table.html.twig' with {
        displays: transparencyLogDisplays,
    } only %}

    {% if transparencyLogDisplays|length and paginator.haveToPaginate() %}
        {{ pagerfanta(paginator, 'twitter_bootstrap', {'proximity': 2}) }}
    {% endif %}
{% endblock %}
