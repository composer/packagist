{% extends "user/layout.html.twig" %}

{% block title %}{{ 'menu.my_organizations'|trans }} - {{ parent() }}{% endblock %}

{% block user_content %}
<section class="col-lg-9">
    <h3 class="font-normal profile-title">{{ 'menu.my_organizations'|trans }}</h3>

    {% if organizations is empty %}
        <p class="p-3 bg-body-secondary border rounded text-body-secondary">You do not belong to any organizations yet.</p>
    {% else %}
        <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for organization in organizations %}
                    <tr>
                        <td>
                            <a href="{{ path('organization_show', { organization: organization.slug }) }}">{{ organization.displayName }}</a>
                            {# Groundwork for org deletion (not yet implemented). #}
                            {% if organization.deleted %}
                                <span class="badge bg-warning">deleted</span>
                            {% endif %}
                        </td>
                        <td><code>{{ organization.slug }}</code></td>
                        <td>{{ organization.createdAt|date('Y-m-d') }}</td>
                        <td class="text-end">
                            {% if is_granted(enum('App\\Security\\Voter\\OrganizationActions').Edit.value, organization) %}
                                <a href="{{ path('organization_settings', { organization: organization.slug }) }}" class="btn btn-secondary btn-sm">Settings</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</section>
{% endblock %}
