{% extends 'layout.html.twig' %}

{% block content %}
    <h2 class="title">Authenticator app</h2>
    <p>Enter the code from your authenticator app to finish signing in.</p>
    <div class="account-form">
        {% if authenticationError %}
            <p class="alert alert-danger">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</p>
        {% endif %}
        <form action="{{ path('2fa_login_check') }}" method="post">
            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}
            <div class="form-group">
                <label for="_auth_code">Authentication code</label>
                <div class="input-group">
                    <span class="input-group-text"><span class="icon-key" aria-hidden="true"></span></span>
                    <input id="_auth_code" class="form-control" type="text" autocomplete="off" name="{{ authCodeParameterName }}">
                </div>
            </div>
            {% if displayTrustedOption %}
                <div class="form-group">
                    <div class="form-check">
                        <input class="form-check-input" id="_trusted" type="checkbox" name="{{ trustedParameterName }}">
                        <label class="form-check-label" for="_trusted">Trust this computer for 30 days</label>
                    </div>
                </div>
            {% endif %}
            <div class="form-actions mb-4">
                <input type="submit" class="btn btn-primary" value="{{ 'login'|trans({}, 'SchebTwoFactorBundle') }}">
                {# The logout link gives the user a way out if they can't complete two-factor authentication #}
                <a class="btn btn-secondary" href="{{ logout_path() }}">Cancel</a>
            </div>
        </form>
        {% if 'webauthn' in availableTwoFactorProviders %}
            <p><a href="{{ path('2fa_login', {preferProvider: 'webauthn'}) }}">Use passkey or security key instead</a></p>
        {% endif %}
        <details class="mb-3">
            <summary>Lost access?</summary>
            <p class="mt-2">{{ app.user.hasVerifiedHardwareKey ? 'Your backup code signs you in once. Your verified keys stay enrolled. If you have lost all of them, request a reset.' : 'Enter your backup code in the form above instead. Using it disables your configured second factors.' }}</p>
            <p class="mb-0">Need help recovering your second factors? <a href="{{ path('support_lost_second_factor') }}">Request a reset</a>.</p>
        </details>
    </div>
{% endblock %}
