{#
    One log table for every log we render: the internal audit log (admin, organization, filter list
    entry) and the public transparency log. The displays only have to implement
    App\Log\Display\LogDisplayInterface.

    displays                   - list of log displays
    emptyMessage               - shown instead of the table when there is nothing to list
    showIp                     - render the IP column (audit log only, and only for auditors)
    surroundingLogsRoute       - when set, the timestamp links to that route filtered to a +/- 2 minute window
    surroundingLogsRouteParams - extra route params for the link above
#}
{% set emptyMessage = emptyMessage ?? 'No log entries found.' %}
{% set showIp = showIp ?? false %}
{% set surroundingLogsRoute = surroundingLogsRoute ?? null %}
{% set surroundingLogsRouteParams = surroundingLogsRouteParams ?? {} %}

{% if displays|length %}
    <div class="audit-log-table-container">
        <table class="table audit-log-table">
            <thead>
                <tr>
                    <th class="audit-log-datetime">Date &amp; Time</th>
                    <th class="audit-log-type">Type</th>
                    <th class="audit-log-details">Details</th>
                    {% if showIp %}
                        <th class="audit-log-ip">IP</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for display in displays %}
                    <tr>
                        <td class="audit-log-datetime">
                            {% if surroundingLogsRoute %}
                                {% set fromDate = display.dateTime|date_modify('-2 minutes')|date('Y-m-d\\TH:i:s') %}
                                {% set toDate = display.dateTime|date_modify('+2 minutes')|date('Y-m-d\\TH:i:s') %}
                                <a href="{{ path(surroundingLogsRoute, surroundingLogsRouteParams|merge({'datetime_from': fromDate, 'datetime_to': toDate})) }}" title="Show surrounding logs">
                                    <span class="bi bi-clock-fill"></span> {{ display.dateTime|date('Y-m-d H:i:s') }} UTC
                                </a>
                            {% else %}
                                <span class="bi bi-clock-fill"></span> {{ display.dateTime|date('Y-m-d H:i:s') }} UTC
                            {% endif %}
                        </td>
                        <td class="audit-log-type" data-test="log-type">{{ display.typeTranslationKey|trans }}</td>
                        <td class="audit-log-details">
                            {% include display.templateName with {display} only %}
                            {% if showIp %}
                                <div class="audit-log-details-ip">IP: {{ display.ip }}</div>
                            {% endif %}
                        </td>
                        {% if showIp %}
                            <td class="audit-log-ip">{{ display.ip }}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info">
        <p>{{ emptyMessage }}</p>
    </div>
{% endif %}
