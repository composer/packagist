{% extends "layout.html.twig" %}

{% block title %}
    Packagist - Transparency Log
{% endblock %}

{% block head_additions %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
    <h2 class="title">Transparency Log</h2>

    {% embed 'log/_filters.html.twig' with {route: 'view_transparency_log'} %}
        {% block type_options %}
            {% for type in selectableTypes %}
                <option value="{{ type.value }}" {% if type.value in selectedFilters.type %}selected="selected"{% endif %}>
                    {{ ('log.type.' ~ type.value)|trans }}
                </option>
            {% endfor %}
        {% endblock %}

        {% block fields %}
            <div class="row">
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="vendor-filter">Vendor</label>
                        <input type="text" name="vendor" id="vendor-filter" class="form-control" value="{{ selectedFilters.vendor }}" placeholder="Filter by vendor">
                    </div>
                </div>
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="package-filter">Package Name</label>
                        <input type="text" name="package" id="package-filter" class="form-control" value="{{ selectedFilters.package }}" placeholder="Filter by package name">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="user-filter">Maintainer</label>
                        <input type="text" name="user" id="user-filter" class="form-control" value="{{ selectedFilters.user }}" placeholder="Filter by username">
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endembed %}

    {% include 'log/_time_range.html.twig' %}

    {% include 'log/_table.html.twig' with {
        displays: transparencyLogDisplays,
        emptyMessage: 'No transparency log entries found.',
    } only %}

    {% if transparencyLogDisplays|length and paginator.haveToPaginate() %}
        {{ pagerfanta(paginator, 'twitter_bootstrap5', {'proximity': 2}) }}
    {% endif %}
{% endblock %}
