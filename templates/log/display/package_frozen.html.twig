{% import 'log/macros.html.twig' as log %}

<strong>{{ log.packageLink(display.packageName) }}</strong><br>
Repository: {{ display.repository }}<br>
Reason:
{% if display.reason == 'spam' -%}
    Spam
{% elseif display.reason == 'remote_id' -%}
    Remote ID mismatch
{% elseif display.reason == 'gone' -%}
    Repository gone
{% else -%}
    {{ display.reason|capitalize }}
{% endif -%}<br>
{% if display.internalReason %}Internal reason: {{ display.internalReason }}<br>{% endif %}
Frozen by: {{ display.actor.username }}
