{% extends "web/stats_base.html.twig" %}

{% block title %}PHP Version Statistics - {{ parent() }}{% endblock %}

{% block content %}
    {{ parent() }}

    {% if type == 'phpplatform' %}
        <p>Platform PHP Stats are made of the config.platform.php version if it is set, and the effective PHP version otherwise.</p>
    {% endif %}

    <section class="row">
        <div class="col-xl-12">
            <h3>Package installations by PHP minor version, daily</h3>

            <div class="row">
                <div class="chart chart-tall col-12 js-php-daily-stats"></div>
            </div>
        </div>
    </section>

    <section class="row">
        <div class="col-xl-12">
            <h3>Package installations by PHP minor version, monthly</h3>

            <div class="row">
                <div class="chart chart-tall col-12 js-php-monthly-stats"></div>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/charts.css') }}" />
{% endblock %}

{% block scripts %}
    <script nonce="{{ csp_nonce('script') }}" src="{{ asset('build/charts.js') }}"></script>
    <script nonce="{{ csp_nonce('script') }}">
        (function () {
            initGlobalPhpStats('.js-php-daily-stats', {{ dailyData|json_encode|raw }});
            initGlobalPhpStats('.js-php-monthly-stats', {{ monthlyData|json_encode|raw }});
        }());
    </script>
{% endblock %}
