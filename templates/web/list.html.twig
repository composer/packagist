{% extends noLayout|default(false) ? "base_nolayout.html.twig" : "layout.html.twig" %}

{% import "macros.html.twig" as macros %}

{% block content %}
    {% block content_title %}<h3 class="title">{{ 'listing.title'|trans }}</h3>{% endblock %}

    {% block list %}
        {% if packages|length %}
            {{ macros.listPackages(packages, paginate is not defined or paginate, showAutoUpdateWarning|default(false), meta|default(null), showFrozen|default(false)) }}
        {% else %}
            <p class="p-3 bg-body-secondary border rounded text-body-secondary">{{ 'listing.nopackages'|trans }}</p>
        {% endif %}
    {% endblock %}
{% endblock %}
