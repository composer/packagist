{% macro listPackages(packages, paginate, showAutoUpdateWarning, meta, showFrozen) %}
    {# On listings that opt in (a user's own package list), package moderators additionally see the
       suppressed (spam/malware) frozen packages, flagged as [FROZEN], for review clarity. Browse/
       search/vendor listings never opt in, so frozen packages stay hidden there. #}
    {% set canSeeFrozen = showFrozen|default(false) and is_granted('ROLE_DISABLE_PACKAGES') %}
    <ul class="packages list-unstyled">
        {% for package in packages|filter(package => canSeeFrozen or package.isFrozen() is not defined or not package.isFrozen() or not package.getFreezeReason().suppressesPackage()) %}
            {% if package.id is numeric %}
                {% set packageUrl = path('view_package', { 'name' : package.name }) %}
            {% else %}
                {% set packageUrl = path('view_providers', { 'name' : package.name }) %}
            {% endif %}
            <li data-url="{{ packageUrl }}" class="row">
                <div class="col-12 package-item">
                    <div class="row">
                        <div class="col-md-9 col-xl-10">
                            {% if package.language is defined and package.language is not empty %}<p class="float-end language">{{ package.language }}</p>{% endif %}
                            <h4 class="font-bold">
                                <a href="{{ packageUrl }}">{{ package.name }}</a>{% if package.type in ['php-ext', 'php-ext-zend'] %}<span title="PIE installable extension package">🥧</span>{% endif %}
                                {% if canSeeFrozen and package.isFrozen() is defined and package.isFrozen() %}
                                    <small class="text-danger" title="{{ package.getFreezeReason().translationKey()|trans }}">[FROZEN: {{ package.getFreezeReason().value }}]</small>
                                {% endif %}
                                {% if package.id is not numeric %}
                                    <small>(Virtual Package)</small>
                                {% endif %}
                                {% if not package.abandoned|default(false) %}
                                    {% if showAutoUpdateWarning and '://github.com/' in package.repository and package.getAutoUpdated() == 1 %}
                                        <small>(Legacy Auto-Update, Needs Attention)</small>
                                    {% elseif showAutoUpdateWarning and '://github.com/' in package.repository and package.getAutoUpdated() == 0 %}
                                        <small>(Not Auto-Updated, Needs Attention)</small>
                                    {% elseif showAutoUpdateWarning and not package.isAutoUpdated() %}
                                        <small>(Not Auto-Updated)</small>
                                    {% endif %}
                                {% endif %}
                            </h4>
                            {% if package.description is defined and package.description %}
                                <p>{{ package.description|u.truncate(300) }}</p>
                            {% endif %}
                            {% if meta.spamScores is defined and meta.spamScores[package.id] is defined %}
                                {% set score = meta.spamScores[package.id] %}
                                <p>
                                    <span class="badge {{ score.safe ? 'bg-success' : 'bg-danger' }}"
                                          title="Classifier estimate. {{ score.safe ? 'Would be auto-cleared as safe.' : 'Would be kept for review.' }}">
                                        spam {{ (score.metadata * 100)|round }}%{% if score.readme is not null %} · readme {{ (score.readme * 100)|round }}%{% endif %} · {{ score.safe ? 'auto-safe' : 'review' }}
                                    </span>
                                </p>
                            {% endif %}
                            {% if package.abandoned|default(false) %}
                                <p class="abandoned">
                                    <i class="bi bi-exclamation-circle-fill"></i> Abandoned!
                                    {% if package.replacementPackage and ('://' in package.replacementPackage or package.replacementPackage is existing_package) %}
                                        See <a href="{{ '://' in package.replacementPackage ? package.replacementPackage : path('view_package', {name: package.replacementPackage}) }}">{{ package.replacementPackage }}</a>
                                    {% endif %}
                                </p>
                            {% endif %}
                            {% if package.meta is defined %}
                                <p class="meta">{{ package.meta }}</p>
                            {% endif %}
                        </div>
                        <div class="col-md-3 col-xl-2">
                            {% if meta %}
                                <p class="metadata">
                                    <span class="metadata-block"><i class="bi bi-download"></i> {{ meta.downloads[package.id]|default(0)|number_format(0, '.', '&#8201;')|raw }}</span>
                                    <span class="metadata-block"><i class="bi bi-star-fill"></i> {{ meta.favers[package.id]|default(0)|number_format(0, '.', '&#8201;')|raw }}</span>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>

    {% if paginate is defined and paginate and packages.haveToPaginate() %}
        {{ pagerfanta(packages, 'twitter_bootstrap', {'proximity': 2}) }}
    {% endif %}
{% endmacro %}

{% macro listPackagesShort(packages, showVersion, showMoreUrl) %}
    <ul class="list-unstyled">
        {% for package in packages %}
            <li>
                <a href="{{ path('view_package', {'name' : package.name }) }}">{{ package.name }}{% if showVersion is defined and showVersion %}<strong>{{ package.version }}</strong>{% endif %}</a>
                {{ package.description|u.truncate(60) }}
            </li>
        {% endfor %}
        {% if showMoreUrl is defined and showMoreUrl %}
            <li><a href="{{ path('browse_popular') }}">See more...</a></li>
        {% endif %}
    </ul>
{% endmacro %}

{% macro packageLink(packageName, type) %}
    {%- if type == 'provide' -%}
        <a href="{{ path('view_providers', { 'name': packageName }) }}">{{ packageName }}</a>
    {%- elseif packageName is existing_package -%}
        <a href="{{ path('view_package', { 'name': packageName }) }}">{{ packageName }}</a>
    {%- elseif packageName is existing_provider -%}
        <a href="{{ path('view_providers', { 'name': packageName }) }}">{{ packageName }}</a>
    {%- else -%}
        {{ packageName }}
    {%- endif -%}
{% endmacro %}
