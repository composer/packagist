{% extends "admin/layout.html.twig" %}

{% block title %}{{ request.publicId }} - Support - {{ parent() }}{% endblock %}

{% block admin_content %}
    <div class="row">
        <div class="col-12 package">
            <div class="package-header">
                <h2 class="title">
                    {{ request.type.label }}
                    <small><code>{{ request.publicId }}</code></small>
                    <span class="badge {{ request.status.badgeClass }}">{{ request.status.label }}</span>
                </h2>
                <p>
                    From <a href="{{ path('user_profile', {name: request.user.username}) }}">{{ request.user.username }}</a>
                    on {{ request.createdAt|date('Y-m-d H:i') }} UTC.
                    {% if request.type.value == 'lost_2fa' %}
                        <a href="{{ path('user_2fa_configure', {name: request.user.username}) }}">Two-factor settings</a>.
                    {% endif %}
                </p>
            </div>
        </div>
    </div>

    <section class="row">
        <div class="col-lg-7">
            <h3>What they said</h3>
            {% if request.description %}
                <p class="border rounded p-3 bg-body-tertiary">{{ request.description|nl2br }}</p>
            {% else %}
                <p class="text-muted">Nothing beyond the request itself.</p>
            {% endif %}

            {% if request.type.value == 'package_transfer' %}
                <h3>Packages requested</h3>
                <table class="table">
                    <thead><tr><th>Package</th><th>Downloads</th><th>Current maintainers</th><th></th></tr></thead>
                    <tbody>
                        {% for row in resolvedPackages %}
                            <tr>
                                <td>
                                    {% if row.package %}
                                        <a href="{{ path('view_package', {name: row.package.name}) }}">{{ row.package.name }}</a>
                                    {% else %}
                                        {{ row.name }} <span class="badge bg-secondary">not found</span>
                                    {% endif %}
                                </td>
                                <td>{% if row.package %}{{ row.downloads|number_format }}{% endif %}</td>
                                <td>
                                    {% if row.package %}
                                        {% for maintainer in row.package.maintainers %}
                                            <a href="{{ path('user_profile', {name: maintainer.username}) }}">{{ maintainer.username }}</a>{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if row.package %}
                                        <a class="btn btn-primary btn-xs" href="{{ path('view_package', {name: row.package.name}) }}#maintainers">Transfer to {{ request.user.username }}</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if request.type.value == 'vendor_claim' %}
                <h3>Vendor requested</h3>
                <p>
                    <a href="{{ path('view_vendor', {vendor: request.vendorName}) }}">{{ request.vendorName }}</a>
                    &mdash; check who maintains the packages already under it before handing it over.
                </p>
            {% endif %}

            {% if request.type.value == 'account_deletion' %}
                <h3>Packages on this account</h3>
                <table class="table">
                    <thead><tr><th>Package</th><th>Downloads</th><th>Maintainers</th></tr></thead>
                    <tbody>
                        {% for row in requesterPackages %}
                            <tr>
                                <td><a href="{{ path('view_package', {name: row.package.name}) }}">{{ row.package.name }}</a></td>
                                <td>{{ row.downloads|number_format }}</td>
                                <td>{{ row.maintainers }}{% if row.maintainers == 1 %} <span class="badge bg-warning text-dark">sole</span>{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p>
                    Deleting the account is done from
                    <a href="{{ path('user_profile', {name: request.user.username}) }}">their profile</a>, once the
                    packages have been dealt with. That also removes this request.
                </p>
            {% endif %}

            <h3>Thread</h3>
            {% for message in request.messages %}
                <div class="border rounded p-3 mb-2 {{ message.internal ? 'bg-body-tertiary' : '' }}">
                    <p class="mb-1">
                        <strong>{{ message.author ? message.author.username : 'deleted user' }}</strong>
                        <small class="text-muted">{{ message.createdAt|date('Y-m-d H:i') }}</small>
                        {% if message.internal %}
                            <span class="badge bg-secondary">Internal &mdash; not visible to the user</span>
                        {% else %}
                            <span class="badge bg-info">Sent to {{ request.user.email }}</span>
                        {% endif %}
                    </p>
                    <p class="mb-0">{{ message.contents|nl2br }}</p>
                </div>
            {% else %}
                <p class="text-muted">No notes or replies yet.</p>
            {% endfor %}

            <h3>Add an internal note</h3>
            <form method="post" action="{{ path('admin_support_request_note', {publicId: request.publicId}) }}">
                <input type="hidden" name="token" value="{{ csrf_token(csrfTokenId) }}" />
                <div class="mb-3">
                    <textarea class="form-control" name="contents" rows="3" placeholder="Only visible to admins"></textarea>
                </div>
                <button type="submit" class="btn btn-secondary">Add note</button>
            </form>

            <h3>Reply to {{ request.user.username }}</h3>
            <form method="post" action="{{ path('admin_support_request_reply', {publicId: request.publicId}) }}">
                <input type="hidden" name="token" value="{{ csrf_token(csrfTokenId) }}" />
                <div class="mb-3">
                    <textarea class="form-control" name="contents" rows="10">{{ suggestedReply }}</textarea>
                    <div class="form-text">Sent as plain text to {{ request.user.email }}. Replies come back to contact@packagist.org.</div>
                </div>
                <button type="submit" class="btn btn-primary">Send reply</button>
            </form>
        </div>

        <div class="col-lg-5">
            {% if request.type.value == 'lost_2fa' %}
                <h3>Risk</h3>

                {% if risk.isHighRisk %}
                    <div class="alert alert-danger">
                        <strong>Check this one carefully.</strong>
                        <ul class="mb-0">
                            {% if risk.hasRecentCredentialChange %}
                                <li>Password or email changed in the last 7 days &mdash; an attacker may already hold this account.</li>
                            {% endif %}
                            {% for package in risk.solePopularPackages %}
                                <li>Sole maintainer of <strong>{{ package.name }}</strong> ({{ package.downloads|number_format }} downloads).</li>
                            {% endfor %}
                            {% if risk.organizationCount %}
                                <li>Member of {{ risk.organizationCount }} organization(s).</li>
                            {% endif %}
                        </ul>
                    </div>
                {% else %}
                    <div class="alert alert-success">
                        Nothing high-value on this account: {{ risk.totalDownloads|number_format }} downloads across
                        {{ risk.packages|length }} package(s), no organizations.
                    </div>
                {% endif %}

                <ul class="list-unstyled">
                    <li>Account created {{ request.user.createdAt|date('Y-m-d') }}</li>
                    {% if request.user.lastLogin %}<li>Last login {{ request.user.lastLogin|date('Y-m-d') }}</li>{% endif %}
                    {% if risk.twoFactorEnabledAt %}
                        <li>2FA enabled {{ risk.twoFactorEnabledAt|date('Y-m-d') }}</li>
                    {% endif %}
                    {% set ipKnown = risk.requestIpIsKnown(request.ip) %}
                    {% if ipKnown is not null %}
                        <li>Request IP matches recent account activity: <strong>{{ ipKnown ? 'yes' : 'no' }}</strong></li>
                    {% endif %}
                    {% if is_granted('ROLE_AUDITOR') and request.ip %}
                        <li>Requested from <code>{{ request.ip }}</code></li>
                    {% endif %}
                </ul>

                {% if risk.packages %}
                    <table class="table table-sm">
                        <thead><tr><th>Package</th><th>Downloads</th><th></th></tr></thead>
                        <tbody>
                            {% for package in risk.packages %}
                                <tr>
                                    <td><a href="{{ path('view_package', {name: package.name}) }}">{{ package.name }}</a></td>
                                    <td>{{ package.downloads|number_format }}</td>
                                    <td>{% if package.soleMaintainer %}<span class="badge bg-warning text-dark">sole</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% if previousRequests %}
                    <h4>Earlier reset requests</h4>
                    <ul>
                        {% for previous in previousRequests %}
                            <li>{{ previous.createdAt|date('Y-m-d') }} &mdash; {{ previous.status.label }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if riskAuditDisplays %}
                    <h4>Recent account activity</h4>
                    {% include 'audit_log/_transparency_log_table.html.twig' with {
                        displays: riskAuditDisplays,
                        linkSurroundingLogs: false,
                        emptyMessage: 'No recent security events.'
                    } only %}
                {% endif %}

                <h3>Grant the reset</h3>
                {% if not canGrantTwoFactorReset %}
                    <p class="text-muted">You need the 2FA role to action this.</p>
                {% elseif request.status.value != 'open' %}
                    <p class="text-muted">Already dealt with.</p>
                {% elseif not coolingOffElapsed %}
                    <div class="alert alert-warning">
                        Held until <strong>{{ request.approvableAt|date('Y-m-d H:i') }} UTC</strong> so the account
                        owner has time to object. This account is high value, and the owner was emailed when the
                        request was filed.
                    </div>
                {% else %}
                    <form method="post" action="{{ path('admin_support_request_grant_2fa_reset', {publicId: request.publicId}) }}"
                          onsubmit="return confirm('Disable two-factor authentication on {{ request.user.username }} and tell them it was granted?')">
                        <input type="hidden" name="token" value="{{ csrf_token(csrfTokenId) }}" />
                        <button type="submit" class="btn btn-danger">Disable 2FA and resolve</button>
                    </form>
                    <p class="form-text">
                        Disables 2FA, signs the account out everywhere, emails them the standard granted
                        response, and closes this task.
                    </p>
                {% endif %}
            {% endif %}

            <h3>Status</h3>
            <form method="post" action="{{ path('admin_support_request_status', {publicId: request.publicId}) }}">
                <input type="hidden" name="token" value="{{ csrf_token(csrfTokenId) }}" />
                <div class="btn-group">
                    {% if request.status.value == 'open' %}
                        <button type="submit" name="status" value="resolved" class="btn btn-success">Resolve</button>
                        <button type="submit" name="status" value="closed" class="btn btn-secondary">Close without action</button>
                    {% else %}
                        <button type="submit" name="status" value="open" class="btn btn-warning">Reopen</button>
                    {% endif %}
                </div>
            </form>
        </div>
    </section>
{% endblock %}
