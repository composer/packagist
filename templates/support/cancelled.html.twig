{% extends "layout.html.twig" %}

{% block title %}{{ alreadyActioned ? 'Report received' : 'Two-factor reset request cancelled' }} - {{ parent() }}{% endblock %}

{% block head_additions %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block content %}
    <h2 class="title">{{ alreadyActioned ? 'Report received' : 'Request cancelled' }}</h2>

    <section class="row">
        <div class="col-lg-8">
            {% if alreadyActioned %}
                <div class="alert alert-danger">
                    <p>
                        Request {{ request.publicId }} had already been actioned.
                        <strong>Two-factor authentication was switched off</strong> on your account
                        before you told us this was not you.
                    </p>
                    <p class="mb-0">
                        We have signed your account out everywhere and alerted our admins. Please act
                        on the steps below now.
                    </p>
                </div>
            {% else %}
                <div class="alert alert-success">
                    The two-factor reset request {{ request.publicId }} has been cancelled. Two-factor
                    authentication on your account has not been changed.
                </div>
            {% endif %}

            <p>
                Somebody who is not you knew your password well enough to reach the two-factor prompt,
                so please treat it as compromised:
            </p>

            <ol>
                <li>Log in and <a href="{{ path('change_password') }}">change your password</a> now.</li>
                {% if alreadyActioned %}
                    <li>Set up two-factor authentication again straight away.</li>
                {% endif %}
                <li>If you reused that password anywhere else, change it there too.</li>
                <li>Check your <a href="{{ path('view_transparency_log') }}">account activity</a> for anything you do not recognise.</li>
            </ol>

            <p>
                We have signed your account out everywhere as a precaution.
                {% if alreadyActioned %}
                    Reply to the email you received, or write to
                    <a href="mailto:contact@packagist.org">contact@packagist.org</a>, so we can help you
                    recover the account.
                {% else %}
                    If anything looks wrong, email
                    <a href="mailto:contact@packagist.org">contact@packagist.org</a>.
                {% endif %}
            </p>
        </div>
    </section>
{% endblock %}
