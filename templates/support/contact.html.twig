{% extends "layout.html.twig" %}

{% block title %}Contact - {{ parent() }}{% endblock %}

{% block content %}
    <h2 class="title">Stay up to date</h2>
    <p>If you want to stay in touch with us, here is where we publish news:</p>
    <p>
        <a title="Blog" href="https://blog.packagist.com"><i class="bi bi-newspaper"></i> Private Packagist Blog</a><br/>
        <a title="Mastodon" href="https://phpc.social/@packagist" rel="me"><i class="bi bi-mastodon"></i> packagist@phpc.social</a><br/>
        <a title="BlueSky" href="https://bsky.app/profile/packagist.com"><i class="bi bi-bluesky"></i> packagist.com</a><br/>
        <a title="LinkedIn" href="https://www.linkedin.com/company/packagist/"><i class="bi bi-linkedin"></i> packagist</a><br/>
        <a title="X / Twitter" href="https://x.com/packagist"><i class="bi bi-twitter-x"></i> packagist</a><br/>
    </p>

    <h2 class="title">Contact us</h2>
    <p>
        You can always email us at <a href="mailto:contact@packagist.org">contact@packagist.org</a>, but
        for the most common support issues please use the links below. They allow us to process your request faster.
    </p>

    <section class="row">
        <section class="col-lg-6">
            <h3 id="lost-2fa">Lost access to two-factor authentication / 2FA token</h3>
            <p>
                If you still have your backup code, enter it in place of the authentication code when
                you log in and two-factor authentication will be switched off for your account.
            </p>
            <p>
                Without the backup code, <a href="{{ path('login') }}">start logging in</a> as usual.
                Once you reach the two-factor code prompt you will find a link to request a reset from
                there. We ask for it at that point because your password has already been checked by
                then, which tells us the request really comes from your account.
            </p>
            <p class="text-muted">
                Lost your password as well? Then you are stuck: resetting your password asks for a
                two-factor code, which a backup code cannot stand in for, and the request link above
                only appears once your password has been accepted. Email us and we will sort it out
                with you directly.
            </p>
        </section>

        <section class="col-lg-6">
            <h3 id="package-transfer">Have a package transferred to you</h3>
            <p>
                For packages whose maintainer is unreachable, or that belong to a project you have
                taken over.
            </p>
            <a class="btn btn-primary" href="{{ path('support_package_transfer') }}">Request a transfer</a>
        </section>

        <div class="clearfix"></div>

        <section class="col-lg-6">
            <h3 id="vendor-claim">Claim a vendor name</h3>
            <p>
                If a vendor namespace already holds packages but you think it should belong to you, ask for it here.
            </p>
            <a class="btn btn-primary" href="{{ path('support_vendor_claim') }}">Claim a vendor name</a>
        </section>

        <section class="col-lg-6">
            <h3 id="delete-account">Delete your account</h3>
            <p>
                If your account maintains no packages you can delete it yourself from your profile
                page. Otherwise you can request deletion here.
            </p>
            <a class="btn btn-primary" href="{{ path('support_delete_account') }}">Request deletion</a>
        </section>
    </section>
{% endblock %}
