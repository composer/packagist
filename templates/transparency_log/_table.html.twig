{% set emptyMessage = emptyMessage ?? 'No transparency log entries found.' %}

{% if displays|length %}
    <table class="table audit-log-table">
        <thead>
            <tr>
                <th class="audit-log-datetime">Date &amp; Time</th>
                <th class="audit-log-type">Type</th>
                <th class="audit-log-details">Details</th>
            </tr>
        </thead>
        <tbody>
            {% for display in displays %}
                <tr>
                    <td class="audit-log-datetime">
                        <span class="glyphicon glyphicon-time"></span> {{ display.dateTime|date('Y-m-d H:i:s') }} UTC
                    </td>
                    <td class="audit-log-type" data-test="transparency-log-type">{{ display.typeTranslationKey|trans }}</td>
                    <td class="audit-log-details">
                        {% include display.templateName with {display} only %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <div class="alert alert-info">
        <p>{{ emptyMessage }}</p>
    </div>
{% endif %}
